<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.manifestai.growth</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/yageloshri/ManifestAI-Gratitude-Journal/aso/run_weekly_growth.sh</string>
  </array>
  <!-- Every 3 days (259200s). ASO ranks move fast; weekly misses swings.
       StartInterval fires ~3 days after load and every 3 days after; if the
       Mac is asleep at fire time, launchd runs it on next wake. -->
  <key>StartInterval</key><integer>259200</integer>
  <key>StandardOutPath</key><string>/Users/yageloshri/ManifestAI-Gratitude-Journal/aso/logs/launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/yageloshri/ManifestAI-Gratitude-Journal/aso/logs/launchd.err</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
